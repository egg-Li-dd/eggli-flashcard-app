import { useState, useRef, useCallback, useEffect } from 'react'
import { useNavigate } from 'react-router-dom'
import { SUMMARY_LEVELS } from '../utils/constants'
import { cleanUpSpeechText } from '../services/aiService'
import { createAudioRecorder, isMediaRecorderSupported, isSecureContextForMic, resolveAvailableMode, isNetworkAvailable } from '../services/recorder'
import { transcribeWithWhisperAPI, transcribeWithIflytek, transcribeWithDashscope, transcribeWithIflytekBigModel, transcribeWithIflytekRtasrStd, transcribeWithIflytekRtasrLlm, transcribeWithIflytekOst } from '../services/transcribe'
import { isVoskAvailable, startVoskListening, stopVoskListening, cancelVoskListening, addVoskPartialListener, checkVoskModel } from '../services/voskService'
import { useApp } from '../context/AppContext'
import { parseDocument, createPcVoiceSession } from '../services/pcEngineProxy'

const SpeechRecognitionGlobal =
  (typeof window !== 'undefined' &&
    (window.SpeechRecognition || window.webkitSpeechRecognition)) ||
  null

let CapacitorSpeechReady = false
let CapacitorSpeechMod = null

const loadCapacitorSpeech = () => {
  if (CapacitorSpeechReady) return Promise.resolve(CapacitorSpeechMod)
  return import('@capacitor-community/speech-recognition')
    .then((m) => {
      CapacitorSpeechMod = m.SpeechRecognition
      CapacitorSpeechReady = true
      return CapacitorSpeechMod
    })
    .catch(() => {
      CapacitorSpeechReady = true
      return null
    })
}

export default function InputBar({
  value,
  onChange,
  onSubmit,
  onImageOCR,
  ocrLoading,
  summaryLevel,
  onSummaryLevelChange,
  disabled,
  apiKey,
  model,
  onToast,
}) {
  const { state } = useApp()
  const navigate = typeof useNavigate === 'function' ? useNavigate() : null

  const voskReady = state?.voskReady || false
  const voskModelStatus = state?.voskModelStatus

  const goSettings = useCallback(() => {
    if (navigate) navigate('/settings')
  }, [navigate])

  const [recording, setRecording] = useState(false)
  const [starting, setStarting] = useState(false)
  const [cleaning, setCleaning] = useState(false)
  const [transcribing, setTranscribing] = useState(false)
  const [toolbarOpen, setToolbarOpen] = useState(false)
  const [expandOpen, setExpandOpen] = useState(false)
  const [draftText, setDraftText] = useState('')
  const [voiceMode, setVoiceMode] = useState(false)
  const [voicePreview, setVoicePreview] = useState('')
  const [showVoiceConfirm, setShowVoiceConfirm] = useState(false)
  const [pcDocParsing, setPcDocParsing] = useState(false)
  const [pcDocProgress, setPcDocProgress] = useState(0)
  const textareaRef = useRef(null)
  const panelTextareaRef = useRef(null)
  const [pauseDetected, setPauseDetected] = useState(false)
  const [recordingDuration, setRecordingDuration] = useState(0)
  const recordingStartTimeRef = useRef(null)
  const durationTimerRef = useRef(null)
  const recognitionRef = useRef(null)
  const audioRecorderRef = useRef(null)
  const voskListenerRef = useRef(null)
  const hangCheckRef = useRef(null)
  const longPressTimerRef = useRef(null)
  const pauseTimerRef = useRef(null)
  const cameraInputRef = useRef(null)
  const galleryInputRef = useRef(null)
  const documentInputRef = useRef(null)
  const pcVoiceSessionRef = useRef(null)
  const pcVoiceAbortRef = useRef(null)
  const transcriptRef = useRef('')
  const partialTranscriptRef = useRef('')
  const lastVoiceTimeRef = useRef(0)
  const downgradeNotifiedRef = useRef(false)
  const iflytekFailuresRef = useRef(0)
  const pointerHandledRef = useRef(false)
  const MAX_RECORDING_DURATION = 60 * 1000
  const AUTO_PAUSE_THRESHOLD = 1500

  const autoResize = useCallback(() => {
    const el = textareaRef.current
    if (!el) return
    el.style.height = 'auto'
    const lineHeight = 22
    const maxHeight = lineHeight * 3 + 20
    const newHeight = Math.min(el.scrollHeight, maxHeight)
    el.style.height = newHeight + 'px'
    el.style.overflowY = el.scrollHeight > maxHeight ? 'auto' : 'hidden'
  }, [])

  useEffect(() => {
    autoResize()
  }, [value, autoResize])

  const fmt = (s) => `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`

  const isSecureContext =
    typeof window !== 'undefined' &&
    (window.isSecureContext ||
      location.hostname === 'localhost' ||
      location.hostname === '127.0.0.1')

  const showMsg = useCallback(
    (msg, type, actions) => {
      if (typeof onToast === 'function') {
        onToast(msg, type, actions)
      } else {
        alert(msg)
      }
    },
    [onToast],
  )

  // 权限被拒绝时统一处理：提示用户并引导到系统设置授权
  const handlePermissionDenied = useCallback(
    async (reason) => {
      const isNative =
        typeof window !== 'undefined' &&
        ((window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform()) ||
          window.Capacitor?.Plugins?.VoskASR)
      if (isNative && window.Capacitor?.Plugins?.VoskASR) {
        showMsg(
          reason || '麦克风权限被拒绝，正在为您打开应用设置页面，请授权后重试',
          'error',
          [
            {
              label: '去设置',
              onClick: () => {
                window.Capacitor.Plugins.VoskASR.openAppSettings().catch(() => {})
              },
            },
          ],
        )
      } else {
        showMsg(reason || '麦克风权限被拒绝，请在浏览器设置中允许麦克风访问后重试', 'error')
      }
    },
    [showMsg],
  )

  const createSpeechRecognition = useCallback(() => {
    if (!SpeechRecognitionGlobal) throw new Error('BROWSER_NOT_SUPPORTED')
    const rec = new SpeechRecognitionGlobal()
    rec.lang = 'zh-CN'
    rec.interimResults = true
    rec.continuous = true
    rec.maxAlternatives = 1
    return rec
  }, [])

  const startNativeRecognition = useCallback(async () => {
    const mod = await loadCapacitorSpeech()
    if (!mod) return null
    let listenersAttached = false
    let onResultCb = null
    let onEndCb = null
    let onErrorCb = null
    const api = {
      set onresult(fn) { onResultCb = fn },
      set onend(fn) { onEndCb = fn },
      set onerror(fn) { onErrorCb = fn },
      async start() {
        try {
          if (!listenersAttached) {
            const l1 = await mod.addListener('partialResult', (data) => {
              const text = (data && data.matches && data.matches[0]) || ''
              if (onResultCb && text) onResultCb({ results: [[{ transcript: text, isFinal: false }]] })
            })
            const l2 = await mod.addListener('onResult', (data) => {
              const text =
                (data && data.matches && data.matches[0]) ||
                (data && data.text) ||
                ''
              if (onResultCb && text) onResultCb({ results: [[{ transcript: text, isFinal: true }]] })
            })
            api._listeners = [l1, l2]
            listenersAttached = true
          }
          await mod.start({
            language: 'zh-CN',
            maxResults: 1,
            prompt: '',
            partialResults: true,
            popup: false,
          })
        } catch (err) {
          const msg = (err && (err.message || err.code)) || 'unknown'
          if (onErrorCb) onErrorCb({ error: msg })
          else if (onEndCb) onEndCb()
        }
      },
      async stop() {
        try { await mod.stop() } catch (e) {}
        if (onEndCb) onEndCb()
      },
      async destroy() {
        if (api._listeners) {
          for (const l of api._listeners) {
            try { await l.remove() } catch (e) {}
          }
        }
      },
    }
    return api
  }, [])

  const handlePartialResult = useCallback((text) => {
    if (!text) return
    partialTranscriptRef.current = text
    setVoicePreview(text)
    lastVoiceTimeRef.current = Date.now()
    setPauseDetected(false)
    if (pauseTimerRef.current) {
      clearTimeout(pauseTimerRef.current)
      pauseTimerRef.current = null
    }
    pauseTimerRef.current = setTimeout(() => {
      setPauseDetected(true)
      stopRecognition()
    }, AUTO_PAUSE_THRESHOLD)
  }, [])

  const handleCleanupAndWrite = useCallback(
    async (rawTranscript) => {
      if (!rawTranscript) return
      const text = rawTranscript.trim()
      if (!text) return

      const isSparkMode = state.aiServiceMode === 'iflytek-spark'
      const isVolcanoMode = state.aiServiceMode === 'volcano'
      const isDashscopeMode = state.aiServiceMode === 'dashscope'
      const hasSparkCreds = !!state.iflytekSparkApiKey
      const hasVolcanoCreds = !!state.volcanoApiKey
      const hasDashscopeCreds = !!state.dashscopeApiKey
      const hasApiKey = !!apiKey
      const hasCreds = isSparkMode
        ? hasSparkCreds
        : isVolcanoMode
          ? hasVolcanoCreds
          : isDashscopeMode
            ? hasDashscopeCreds
            : hasApiKey

      if (!hasCreds) {
        setVoicePreview(text)
        setShowVoiceConfirm(true)
        let tip = '未设置 API Key，语音文本未做 AI 整理'
        if (isSparkMode) tip = '未设置讯飞星火 APIPassword，跳过 AI 整理'
        else if (isVolcanoMode) tip = '未设置火山引擎 API Key，跳过 AI 整理'
        else if (isDashscopeMode) tip = '未设置千问 API Key，跳过 AI 整理'
        showMsg(tip, 'warn')
        return
      }

      setCleaning(true)
      try {
        const isVolcano = state.aiServiceMode === 'volcano'
        const isDashscope = state.aiServiceMode === 'dashscope'
        const effectiveModel = isSparkMode
          ? state.iflytekSparkModel
          : isVolcano
            ? state.volcanoModel
            : isDashscope
              ? state.dashscopeModel
              : (model || 'deepseek-v4-pro')
        const cleaned = await cleanUpSpeechText(
          text, apiKey, effectiveModel, state.aiServiceMode,
          state.iflytekSparkApiKey, state.iflytekSparkApiSecret,
          state.volcanoApiKey, state.dashscopeApiKey,
        )
        setVoicePreview(cleaned)
        setShowVoiceConfirm(true)
        showMsg('AI 整理完成', 'success')
      } catch (err) {
        const fillerPattern = /(嗯|啊|哦|呃|那个|就是说|我想想|对吧|然后呢|然后|这个|就是|反正|怎么说呢|你知道|你知道吗)/g
        let cleanedText = text
        try {
          let result = text.replace(fillerPattern, '')
          result = result.replace(/\s{2,}/g, ' ')
          result = result.replace(/([。！？])\s*/g, '$1\n')
          if (result.trim()) {
            cleanedText = result.trim()
          }
        } catch (_) {}
        setVoicePreview(cleanedText)
        setShowVoiceConfirm(true)
        showMsg('AI 整理失败：' + (err.message || '未知错误') + '，已使用本地整理', 'error')
      } finally {
        setCleaning(false)
      }
    },
    [apiKey, model, state, onChange, showMsg],
  )

  const handleVoiceConfirm = useCallback(() => {
    if (voicePreview.trim()) {
      onChange(prev => prev + (prev && !prev.endsWith('\n') ? '\n' : '') + voicePreview)
    }
    setShowVoiceConfirm(false)
    setVoicePreview('')
  }, [voicePreview, onChange])

  const handleVoiceCancel = useCallback(() => {
    setShowVoiceConfirm(false)
    setVoicePreview('')
  }, [])

  // 关闭弹窗时保留文本进输入框（✕ 和背景遮罩使用）
  const handleVoiceSaveAndClose = useCallback(() => {
    if (voicePreview.trim()) {
      onChange(prev => prev + (prev && !prev.endsWith('\n') ? '\n' : '') + voicePreview)
    }
    setShowVoiceConfirm(false)
    setVoicePreview('')
  }, [voicePreview, onChange])

  const resolved = state?.speechMode
    ? resolveAvailableMode(state.speechMode)
    : resolveAvailableMode('web-speech')
  const userEffectiveMode = resolved.mode
  const downgradeReason = resolved.reason

  // PC 引擎优先降级：如果 PC 引擎已配置且可用，自动使用 pc-engine-voice
  const [pcEngineOverride, setPcEngineOverride] = useState(false)
  useEffect(() => {
    let cancelled = false
    async function checkPcEngine() {
      if (state?.pcEngineServer && userEffectiveMode !== 'pc-engine-voice') {
        try {
          const { checkPcEngineAvailable } = await import('../services/pcEngineFallback')
          const { available } = await checkPcEngineAvailable(state)
          if (!cancelled && available) {
            setPcEngineOverride(true)
          } else if (!cancelled) {
            setPcEngineOverride(false)
          }
        } catch {
          if (!cancelled) setPcEngineOverride(false)
        }
      } else {
        setPcEngineOverride(false)
      }
    }
    checkPcEngine()
    return () => { cancelled = true }
  }, [state?.pcEngineServer, state?.pcEnginePort, state?.pcEngineToken, userEffectiveMode])

  const effectiveMode = pcEngineOverride ? 'pc-engine-voice' : userEffectiveMode

  useEffect(() => {
    if (downgradeReason && !downgradeNotifiedRef.current) {
      downgradeNotifiedRef.current = true
      const timer = setTimeout(() => {
        showMsg(downgradeReason, 'info')
      }, 800)
      return () => clearTimeout(timer)
    }
  }, [downgradeReason, showMsg])

  const startRecognition = useCallback(async () => {
    try {
      if (effectiveMode === 'vosk-offline') {
        if (!isVoskAvailable()) {
          setStarting(false)
          showMsg('Vosk离线语音识别仅在APP中可用，请使用APP或切换到其他模式', 'warn', [{ label: '去设置', onClick: goSettings }])
          return
        }

        const modelInfo = await checkVoskModel()
        if (!modelInfo.hasModel) {
          setStarting(false)
          showMsg('未检测到语音模型，请先下载或放置Vosk语音模型', 'warn', [{ label: '去设置', onClick: goSettings }])
          return
        }

        transcriptRef.current = ''
        partialTranscriptRef.current = ''

        try {
          // Vosk 启动超时保护：根据模型大小动态调整超时
          // 小模型（~40MB）3秒足够；大模型（~130MB）需要更长时间加载
          const voskTimeoutMs = modelInfo.modelSize > 50 * 1024 * 1024 ? 10000 : 3000
          const startPromise = startVoskListening()
          const timeoutPromise = new Promise((_, reject) =>
            setTimeout(() => reject(new Error('vosk-start-timeout')), voskTimeoutMs)
          )
          await Promise.race([startPromise, timeoutPromise])

          voskListenerRef.current = addVoskPartialListener((data) => {
            if (data.isFinal) {
              const full = data.fullText || ''
              partialTranscriptRef.current = full
              handlePartialResult(full)
            } else {
              const full = data.fullText || ''
              partialTranscriptRef.current = full
              handlePartialResult(full)
            }
          })

          setStarting(false)
          setRecording(true)
          recordingStartTimeRef.current = Date.now()
          setRecordingDuration(0)
          durationTimerRef.current = setInterval(() => {
            setRecordingDuration(Math.floor((Date.now() - recordingStartTimeRef.current) / 1000))
          }, 500)
        } catch (err) {
          setStarting(false)
          setRecording(false)
          setVoiceMode(false)
          const errMsg = String(err?.message || err || '')
          if (errMsg.includes('vosk-start-timeout')) {
            // 超时：尝试停止可能正在进行的监听
            try { await stopVoskListening() } catch (_) {}
            showMsg('Vosk 启动超时，模型可能正在加载中，请稍后重试', 'warn', [{ label: '去设置', onClick: goSettings }])
          } else if (errMsg.includes('permission') || errMsg.includes('denied') || errMsg.includes('权限')) {
            handlePermissionDenied('无法启动Vosk离线语音识别，请检查麦克风权限')
          } else {
            handlePermissionDenied(errMsg || '无法启动Vosk离线语音识别，请检查麦克风权限')
          }
        }
        return
      }

      if (effectiveMode === 'web-speech') {
        const isTrueCapacitor = () => {
          if (typeof window === 'undefined') return false
          return !!(
            window.Capacitor?.isNativePlatform ||
            (window.Capacitor && window.Capacitor.isPluginAvailable &&
              window.Capacitor.isPluginAvailable('SpeechRecognition')) ||
            (window.webkit && window.webkit.messageHandlers && window.webkit.messageHandlers.bridge) ||
            (window.location && window.location.protocol === 'capacitor:')
          )
        }

        let recognition = null
        let useCapacitor = false
        if (isTrueCapacitor()) {
          try {
            const mod = await loadCapacitorSpeech()
            if (mod) {
              const avail = await mod.available().catch(() => false)
              useCapacitor =
                avail === true ||
                (avail && typeof avail === 'object' && (avail.available === true || avail.supported === true))
            }
          } catch (_) {
            useCapacitor = false
          }
        }

        if (useCapacitor) {
          try {
            const mod = await loadCapacitorSpeech()
            if (mod?.requestPermission) {
              const perm = await mod.requestPermission().catch(() => null)
              const denied =
                perm === false ||
                (perm && typeof perm === 'object' && (perm.granted === false || perm.state === 'denied' || perm.value === 'denied'))
              if (denied) {
                handlePermissionDenied('未获得麦克风权限，请授权后重试')
                return
              }
            }
          } catch (_) {}
          recognition = await startNativeRecognition()
          if (!recognition) {
            showMsg('当前环境无法启动语音识别，请尝试使用 Chrome 浏览器', 'error')
            return
          }
        } else {
          if (!SpeechRecognitionGlobal) {
            showMsg('当前浏览器不支持 Web Speech 语音识别，请在「设置」中切换到「在线语音 API」模式', 'error', [{ label: '去设置', onClick: goSettings }])
            return
          }
          if (!isSecureContextForMic()) {
            showMsg('语音识别需要 HTTPS 环境，请在 HTTPS 或 localhost 下使用', 'error')
            return
          }
          try {
            recognition = createSpeechRecognition()
          } catch (err) {
            showMsg('创建语音识别失败：' + ((err && err.message) || '未知错误'), 'error')
            return
          }
        }

        transcriptRef.current = ''
        partialTranscriptRef.current = ''
        recognitionRef.current = recognition

        let gotResult = false
        let started = false
        if (hangCheckRef.current) clearTimeout(hangCheckRef.current)

        recognition.onstart = () => {
          started = true
          setStarting(false)
          setRecording(true)
          recordingStartTimeRef.current = Date.now()
          setRecordingDuration(0)
          durationTimerRef.current = setInterval(() => {
            setRecordingDuration(Math.floor((Date.now() - recordingStartTimeRef.current) / 1000))
          }, 500)
        }
        recognition.onresult = (event) => {
          gotResult = true
          const result = event?.results?.[0]?.[0]
          if (result) {
            const transcript = result.transcript || ''
            if (transcript) {
              if (result.isFinal) {
                transcriptRef.current = transcript
              } else {
                handlePartialResult(transcript)
              }
            }
          }
        }
        if (typeof recognition.onnomatch !== 'undefined') {
          recognition.onnomatch = () => {}
        }
        recognition.onerror = (event) => {
          const code =
            (event && event.error) ||
            (event && event.message) ||
            (typeof event === 'string' && event) ||
            'unknown'
          const codeStr = String(code).toLowerCase()
          if (hangCheckRef.current) {
            clearTimeout(hangCheckRef.current)
            hangCheckRef.current = null
          }
          setStarting(false)
          setRecording(false)
          setVoiceMode(false)
          if (codeStr.includes('not-allowed') || codeStr.includes('permission') || codeStr.includes('notallowed')) {
            handlePermissionDenied('麦克风权限被拒绝或语音识别服务被禁用，请授权后重试')
          } else if (codeStr.includes('service-not-allowed') || codeStr.includes('servicenotallowed')) {
            showMsg('语音识别服务被系统禁用，请检查浏览器的语音识别权限', 'error')
          } else if (codeStr.includes('no-speech') || codeStr.includes('nospeech')) {
            showMsg('未检测到语音，请靠近麦克风重新录制', 'error')
          } else if (codeStr.includes('audio-capture') || codeStr.includes('audiocapture')) {
            showMsg('未检测到麦克风设备，请检查硬件连接', 'error')
          } else if (codeStr.includes('language-not-supported') || codeStr.includes('languagenotsupported')) {
            showMsg('当前系统不支持中文语音识别', 'error')
          } else if (codeStr.includes('network')) {
            showMsg('语音识别需要网络连接，请检查网络后重试', 'error')
          } else if (codeStr.includes('aborted')) {
            return
          } else {
            showMsg('语音识别出现问题（' + code + '），请重试或切换到「在线语音 API」模式', 'error', [{ label: '去设置', onClick: goSettings }])
          }
          recognitionRef.current = null
        }
        recognition.onend = () => {
          if (hangCheckRef.current) {
            clearTimeout(hangCheckRef.current)
            hangCheckRef.current = null
          }
          const raw = transcriptRef.current || partialTranscriptRef.current
          setStarting(false)
          setRecording(false)
          setVoiceMode(false)
          recognitionRef.current = null
          if (raw) {
            handleCleanupAndWrite(raw)
          } else if (!gotResult) {
            if (started) {
              showMsg('未识别到语音内容，请重试或在「设置」中切换到「在线语音 API」模式', 'warn', [{ label: '去设置', onClick: goSettings }])
            } else {
              showMsg('语音识别未能启动，请重试或切换到「在线语音 API」模式', 'warn', [{ label: '去设置', onClick: goSettings }])
            }
          }
        }
        try {
          if (recognition.start) {
            await recognition.start()
          } else {
            throw new Error('recognition object has no start()')
          }
        } catch (err) {
          if (hangCheckRef.current) { clearTimeout(hangCheckRef.current); hangCheckRef.current = null }
          setStarting(false)
          setRecording(false)
          setVoiceMode(false)
          recognitionRef.current = null
          const msg = String((err && (err.message || err.name)) || 'unknown')
          const lowerMsg = msg.toLowerCase()
          if (lowerMsg.includes('notallowed') || lowerMsg.includes('permission') || lowerMsg.includes('not-allowed')) {
            handlePermissionDenied('麦克风权限被拒绝，请授权后重试')
          } else if (lowerMsg.includes('already started') || lowerMsg.includes('already')) {
            return
          } else {
            showMsg('语音识别启动失败（' + msg + '），请重试或切换到「在线语音 API」模式', 'error', [{ label: '去设置', onClick: goSettings }])
          }
          return
        }

        hangCheckRef.current = setTimeout(() => {
          if (!started && recognitionRef.current) {
            try {
              if (typeof recognitionRef.current.stop === 'function') recognitionRef.current.stop()
              if (typeof recognitionRef.current.abort === 'function') recognitionRef.current.abort()
            } catch (_) {}
            setStarting(false)
            setRecording(false)
            setVoiceMode(false)
            recognitionRef.current = null
            showMsg('语音识别启动超时，浏览器可能不支持此功能，建议在「设置」中切换到「在线语音 API」模式', 'warn', [{ label: '去设置', onClick: goSettings }])
            return
          }
          if (hangCheckRef.current) clearTimeout(hangCheckRef.current)
          hangCheckRef.current = setTimeout(() => {
            if (recognitionRef.current && transcriptRef.current === '' && partialTranscriptRef.current === '') {
              try {
                if (typeof recognitionRef.current.stop === 'function') recognitionRef.current.stop()
                if (typeof recognitionRef.current.abort === 'function') recognitionRef.current.abort()
              } catch (_) {}
              setStarting(false)
              showMsg('语音识别响应超时，建议在「设置」中切换到「在线语音 API」模式', 'warn', [{ label: '去设置', onClick: goSettings }])
            }
          }, 15000)
          }, 3000)
        return
      }

      // ---- 以下所有在线语音模式（whisper-api / iflytek 系列 / dashscope-asr）需要网络 ----
      const ONLINE_RECORDING_MODES = ['whisper-api', 'iflytek-iat', 'iflytek-bigmodel', 'iflytek-rtasr-std', 'iflytek-rtasr-llm', 'iflytek-ost', 'dashscope-asr']
      if (ONLINE_RECORDING_MODES.includes(effectiveMode) && !isNetworkAvailable()) {
        setStarting(false)
        showMsg('当前处于离线状态，在线语音识别需要网络连接。可在「设置 → 语音识别」中切换到 Vosk 离线模式', 'error', [{ label: '去设置', onClick: goSettings }])
        return
      }

      if (effectiveMode === 'whisper-api') {
        if (!isMediaRecorderSupported()) {
          showMsg('当前浏览器不支持录音功能，请尝试使用 Chrome / Edge', 'error')
          return
        }
        if (!isSecureContextForMic()) {
          showMsg('录音需要 HTTPS 环境，请在 HTTPS 或 localhost 下使用', 'error')
          return
        }
        const url = state?.speechApiUrl || ''
        const key = state?.speechApiKey || ''
        // 完整凭证检查：无论 url 是否配置，都需要有效的 API Key（独立的或 DeepSeek 兜底）
        if (!key && !apiKey) {
          showMsg('语音识别需要配置 API Key，请在「设置 → 语音识别」或「设置 → AI 服务」中填写', 'warn', [{ label: '去设置', onClick: goSettings }])
          return
        }

        const recorder = createAudioRecorder(() => {})
        audioRecorderRef.current = recorder
        transcriptRef.current = ''
        try {
          await recorder.start()
          setStarting(false)
          setRecording(true)
          recordingStartTimeRef.current = Date.now()
          setRecordingDuration(0)
          durationTimerRef.current = setInterval(() => {
            setRecordingDuration(Math.floor((Date.now() - recordingStartTimeRef.current) / 1000))
          }, 500)
        } catch (err) {
          setStarting(false)
          showMsg(err?.message || '无法启动麦克风，请检查权限', 'error')
          audioRecorderRef.current = null
        }
        return
      }

      if (effectiveMode === 'iflytek-iat') {
        if (!isMediaRecorderSupported()) {
          showMsg('当前浏览器不支持录音功能，请尝试使用 Chrome / Edge', 'error')
          return
        }
        if (!isSecureContextForMic()) {
          showMsg('录音需要 HTTPS 环境，请在 HTTPS 或 localhost 下使用', 'error')
          return
        }
        if (!state.iflytekIatAppId || !state.iflytekIatApiKey || !state.iflytekIatApiSecret) {
          setStarting(false)
          showMsg('讯飞语音听写需要配置 APPID、APIKey 和 APISecret，请在设置中完成配置', 'error', [{ label: '去设置', onClick: goSettings }])
          return
        }

        const recorder = createAudioRecorder(() => {})
        audioRecorderRef.current = recorder
        transcriptRef.current = ''
        try {
          await recorder.start()
          setStarting(false)
          setRecording(true)
          recordingStartTimeRef.current = Date.now()
          setRecordingDuration(0)
          durationTimerRef.current = setInterval(() => {
            setRecordingDuration(Math.floor((Date.now() - recordingStartTimeRef.current) / 1000))
          }, 500)
        } catch (err) {
          setStarting(false)
          showMsg(err?.message || '无法启动麦克风，请检查权限', 'error')
          audioRecorderRef.current = null
        }
        return
      }

      if (effectiveMode === 'iflytek-bigmodel') {
        if (!isMediaRecorderSupported()) {
          showMsg('当前浏览器不支持录音功能，请尝试使用 Chrome / Edge', 'error')
          return
        }
        if (!isSecureContextForMic()) {
          showMsg('录音需要 HTTPS 环境，请在 HTTPS 或 localhost 下使用', 'error')
          return
        }
        if (!state.iflytekBigModelAppId || !state.iflytekBigModelApiKey || !state.iflytekBigModelApiSecret) {
          setStarting(false)
          showMsg('讯飞中英识别大模型需要配置 APPID、APIKey 和 APISecret，请在设置中完成配置', 'error', [{ label: '去设置', onClick: goSettings }])
          return
        }

        const recorder = createAudioRecorder(() => {})
        audioRecorderRef.current = recorder
        transcriptRef.current = ''
        try {
          await recorder.start()
          setStarting(false)
          setRecording(true)
          recordingStartTimeRef.current = Date.now()
          setRecordingDuration(0)
          durationTimerRef.current = setInterval(() => {
            setRecordingDuration(Math.floor((Date.now() - recordingStartTimeRef.current) / 1000))
          }, 500)
        } catch (err) {
          setStarting(false)
          showMsg(err?.message || '无法启动麦克风，请检查权限', 'error')
          audioRecorderRef.current = null
        }
        return
      }

      if (effectiveMode === 'iflytek-rtasr-std') {
        if (!isMediaRecorderSupported()) {
          showMsg('当前浏览器不支持录音功能，请尝试使用 Chrome / Edge', 'error')
          return
        }
        if (!isSecureContextForMic()) {
          showMsg('录音需要 HTTPS 环境，请在 HTTPS 或 localhost 下使用', 'error')
          return
        }
        if (!state.iflytekRtasrStdAppId || !state.iflytekRtasrStdApiKey) {
          setStarting(false)
          showMsg('讯飞实时语音转写标准版需要配置 APPID 和 APIKey，请在设置中完成配置', 'error', [{ label: '去设置', onClick: goSettings }])
          return
        }

        const recorder = createAudioRecorder(() => {})
        audioRecorderRef.current = recorder
        transcriptRef.current = ''
        try {
          await recorder.start()
          setStarting(false)
          setRecording(true)
          recordingStartTimeRef.current = Date.now()
          setRecordingDuration(0)
          durationTimerRef.current = setInterval(() => {
            setRecordingDuration(Math.floor((Date.now() - recordingStartTimeRef.current) / 1000))
          }, 500)
        } catch (err) {
          setStarting(false)
          showMsg(err?.message || '无法启动麦克风，请检查权限', 'error')
          audioRecorderRef.current = null
        }
        return
      }

      if (effectiveMode === 'iflytek-rtasr-llm') {
        if (!isMediaRecorderSupported()) {
          showMsg('当前浏览器不支持录音功能，请尝试使用 Chrome / Edge', 'error')
          return
        }
        if (!isSecureContextForMic()) {
          showMsg('录音需要 HTTPS 环境，请在 HTTPS 或 localhost 下使用', 'error')
          return
        }
        if (!state.iflytekRtasrLlmAppId || !state.iflytekRtasrLlmAccessKeyId || !state.iflytekRtasrLlmAccessKeySecret) {
          setStarting(false)
          showMsg('讯飞实时语音转写大模型需要配置 APPID、AccessKeyId 和 AccessKeySecret，请在设置中完成配置', 'error', [{ label: '去设置', onClick: goSettings }])
          return
        }

        const recorder = createAudioRecorder(() => {})
        audioRecorderRef.current = recorder
        transcriptRef.current = ''
        try {
          await recorder.start()
          setStarting(false)
          setRecording(true)
          recordingStartTimeRef.current = Date.now()
          setRecordingDuration(0)
          durationTimerRef.current = setInterval(() => {
            setRecordingDuration(Math.floor((Date.now() - recordingStartTimeRef.current) / 1000))
          }, 500)
        } catch (err) {
          setStarting(false)
          showMsg(err?.message || '无法启动麦克风，请检查权限', 'error')
          audioRecorderRef.current = null
        }
        return
      }

      if (effectiveMode === 'iflytek-ost') {
        if (!isMediaRecorderSupported()) {
          showMsg('当前浏览器不支持录音功能，请尝试使用 Chrome / Edge', 'error')
          return
        }
        if (!isSecureContextForMic()) {
          showMsg('录音需要 HTTPS 环境，请在 HTTPS 或 localhost 下使用', 'error')
          return
        }
        if (!state.iflytekOstAppId || !state.iflytekOstApiKey || !state.iflytekOstApiSecret) {
          setStarting(false)
          showMsg('讯飞极速录音转写需要配置 APPID、APIKey 和 APISecret，请在设置中完成配置', 'error', [{ label: '去设置', onClick: goSettings }])
          return
        }

        const recorder = createAudioRecorder(() => {})
        audioRecorderRef.current = recorder
        transcriptRef.current = ''
        try {
          await recorder.start()
          setStarting(false)
          setRecording(true)
          recordingStartTimeRef.current = Date.now()
          setRecordingDuration(0)
          durationTimerRef.current = setInterval(() => {
            setRecordingDuration(Math.floor((Date.now() - recordingStartTimeRef.current) / 1000))
          }, 500)
        } catch (err) {
          setStarting(false)
          showMsg(err?.message || '无法启动麦克风，请检查权限', 'error')
          audioRecorderRef.current = null
        }
        return
      }

      if (effectiveMode === 'dashscope-asr') {
        if (!isMediaRecorderSupported()) {
          showMsg('当前浏览器不支持录音功能，请尝试使用 Chrome / Edge', 'error')
          return
        }
        if (!isSecureContextForMic()) {
          showMsg('录音需要 HTTPS 环境，请在 HTTPS 或 localhost 下使用', 'error')
          return
        }
        if (!state.dashscopeApiKey) {
          setStarting(false)
          showMsg('阿里云千问语音识别需要配置 API Key，请在「设置 → 语音识别」或「设置 → AI 服务」中完成配置', 'error', [{ label: '去设置', onClick: goSettings }])
          return
        }

        const recorder = createAudioRecorder(() => {})
        audioRecorderRef.current = recorder
        transcriptRef.current = ''
        try {
          await recorder.start()
          setStarting(false)
          setRecording(true)
          recordingStartTimeRef.current = Date.now()
          setRecordingDuration(0)
          durationTimerRef.current = setInterval(() => {
            setRecordingDuration(Math.floor((Date.now() - recordingStartTimeRef.current) / 1000))
          }, 500)
        } catch (err) {
          setStarting(false)
          showMsg(err?.message || '无法启动麦克风，请检查权限', 'error')
          audioRecorderRef.current = null
        }
        return
      }

      showMsg(downgradeReason || '当前没有可用的语音识别方式，请在「设置」中切换语音识别模式', 'error', downgradeReason ? [] : [{ label: '去设置', onClick: goSettings }])
    } catch (e) {
      console.error('语音输入启动失败:', e)
      setRecording(false)
      showMsg('语音输入启动失败，请重试或切换到键盘输入', 'error')
    }
  }, [effectiveMode, state, showMsg, handleCleanupAndWrite, handlePartialResult, startNativeRecognition, goSettings])

  const stopRecognition = useCallback(() => {
    setStarting(false)
    if (durationTimerRef.current) {
      clearInterval(durationTimerRef.current)
      durationTimerRef.current = null
    }
    recordingStartTimeRef.current = null
    if (pauseTimerRef.current) {
      clearTimeout(pauseTimerRef.current)
      pauseTimerRef.current = null
    }

    const mode = state?.speechMode || effectiveMode
    if (mode === 'vosk-offline') {
      if (voskListenerRef.current) {
        try {
          voskListenerRef.current()
        } catch (_) {}
        voskListenerRef.current = null
      }
      setCleaning(true)
      setTranscribing(true)
      stopVoskListening()
        .then((text) => {
          setCleaning(false)
          setTranscribing(false)
          setRecording(false)
          if (text && text.trim()) {
            handleCleanupAndWrite(text.trim())
          } else {
            showMsg('未识别到语音内容，请再试一次', 'info')
          }
        })
        .catch((err) => {
          setCleaning(false)
          setTranscribing(false)
          setRecording(false)
          showMsg(err?.message || '语音识别失败，请重试', 'error')
        })
      return
    }
    
    const rec = recognitionRef.current
    if (rec) {
      try {
        if (typeof rec.stop === 'function') {
          const r = rec.stop()
          if (r && typeof r.then === 'function') r.catch(() => {})
        }
      } catch (_) {}
      if (typeof rec.destroy === 'function') {
        try { rec.destroy() } catch (_) {}
      }
      recognitionRef.current = null
    }
    const arec = audioRecorderRef.current
    if (arec) {
      audioRecorderRef.current = null
      setCleaning(true)
      setTranscribing(true)
      arec.stop()
        .then(async (result) => {
          if (!result || !result.blob) {
            setCleaning(false)
            setTranscribing(false)
            return
          }
          try {
            let text = ''
            const mode = state?.speechMode || effectiveMode
            if (mode === 'whisper-api') {
              const url = state?.speechApiUrl || ''
              const key = state?.speechApiKey || ''
              text = await transcribeWithWhisperAPI({
                blob: result.blob,
                fileName: result.fileName,
                apiUrl: url,
                apiKey: key,
                fallbackApiKey: apiKey,
                language: 'zh',
              })
              iflytekFailuresRef.current = 0
            } else if (mode === 'iflytek-iat') {
              text = await transcribeWithIflytek({
                blob: result.blob,
                appId: state.iflytekIatAppId,
                apiKey: state.iflytekIatApiKey,
                apiSecret: state.iflytekIatApiSecret,
              })
              iflytekFailuresRef.current = 0
            } else if (mode === 'iflytek-bigmodel') {
              text = await transcribeWithIflytekBigModel({
                blob: result.blob,
                appId: state.iflytekBigModelAppId,
                apiKey: state.iflytekBigModelApiKey,
                apiSecret: state.iflytekBigModelApiSecret,
              })
              iflytekFailuresRef.current = 0
            } else if (mode === 'iflytek-rtasr-std') {
              text = await transcribeWithIflytekRtasrStd({
                blob: result.blob,
                appId: state.iflytekRtasrStdAppId,
                apiKey: state.iflytekRtasrStdApiKey,
              })
              iflytekFailuresRef.current = 0
            } else if (mode === 'iflytek-rtasr-llm') {
              text = await transcribeWithIflytekRtasrLlm({
                blob: result.blob,
                appId: state.iflytekRtasrLlmAppId,
                accessKeyId: state.iflytekRtasrLlmAccessKeyId,
                accessKeySecret: state.iflytekRtasrLlmAccessKeySecret,
              })
              iflytekFailuresRef.current = 0
            } else if (mode === 'iflytek-ost') {
              text = await transcribeWithIflytekOst({
                blob: result.blob,
                appId: state.iflytekOstAppId,
                apiKey: state.iflytekOstApiKey,
                apiSecret: state.iflytekOstApiSecret,
              })
              iflytekFailuresRef.current = 0
            } else if (mode === 'dashscope-asr') {
              text = await transcribeWithDashscope({
                blob: result.blob,
                fileName: result.fileName,
                apiKey: state.dashscopeApiKey,
                language: 'zh',
              })
              iflytekFailuresRef.current = 0
            }
            setTranscribing(false)
            if (!text) {
              showMsg('未识别到任何文字，请确保录音清晰后重试', 'error')
              return
            }
            try {
              const isSparkMode = state.aiServiceMode === 'iflytek-spark'
              const isVolcanoMode = state.aiServiceMode === 'volcano'
              const isDashscopeMode = state.aiServiceMode === 'dashscope'
              const hasSparkCreds = !!state.iflytekSparkApiKey
              const hasVolcanoCreds = !!state.volcanoApiKey
              const hasDashscopeCreds = !!state.dashscopeApiKey
              const hasApiKey = !!apiKey
              const hasCreds = isSparkMode
                ? hasSparkCreds
                : isVolcanoMode
                  ? hasVolcanoCreds
                  : isDashscopeMode
                    ? hasDashscopeCreds
                    : hasApiKey

              if (hasCreds) {
                const effectiveModel = isSparkMode
                  ? state.iflytekSparkModel
                  : isVolcanoMode
                    ? state.volcanoModel
                    : isDashscopeMode
                      ? state.dashscopeModel
                      : (model || 'deepseek-v4-pro')
                const cleaned = await cleanUpSpeechText(
                  text, apiKey, effectiveModel, state.aiServiceMode,
                  state.iflytekSparkApiKey, state.iflytekSparkApiSecret,
                  state.volcanoApiKey, state.dashscopeApiKey,
                )
                onChange(prev => prev + (prev && !prev.endsWith('\n') ? '\n' : '') + cleaned)
                showMsg('识别完成，AI 已整理', 'success')
              } else {
                onChange(prev => prev + (prev && !prev.endsWith('\n') ? '\n' : '') + text)
                let tip = '识别完成（未配置 DeepSeek API Key，跳过整理）'
                if (isSparkMode) tip = '识别完成（未配置讯飞星火 APIPassword，跳过整理）'
                else if (isVolcanoMode) tip = '识别完成（未配置火山引擎 API Key，跳过整理）'
                else if (isDashscopeMode) tip = '识别完成（未配置千问 API Key，跳过整理）'
                showMsg(tip, 'success')
              }
            } catch (err) {
              onChange(prev => prev + (prev && !prev.endsWith('\n') ? '\n' : '') + text)
              showMsg('AI 整理失败：' + (err?.message || '未知错误') + '，已写入原始文本', 'error')
            }
          } catch (err) {
            const mode = state?.speechMode || effectiveMode
            let extraHint = ''
            if (mode === 'iflytek-iat' || mode === 'iflytek-bigmodel' || mode === 'iflytek-rtasr-std' || mode === 'iflytek-rtasr-llm' || mode === 'iflytek-ost') {
              iflytekFailuresRef.current += 1
              if (iflytekFailuresRef.current >= 2) {
                extraHint = '（讯飞连续失败，建议在设置中切换到浏览器内置语音识别或在线 Whisper API）'
              }
            }
            showMsg('语音识别失败：' + (err?.message || '未知错误') + extraHint, 'error')
          } finally {
            setCleaning(false)
            setTranscribing(false)
            setRecording(false)
          }
        })
        .catch(() => {
          setCleaning(false)
          setTranscribing(false)
          setRecording(false)
        })
      return
    }
    setRecording(false)
  }, [apiKey, model, onChange, state, showMsg, effectiveMode, handleCleanupAndWrite])

  useEffect(() => {
    return () => {
      const rec = recognitionRef.current
      if (rec) {
        try {
          if (typeof rec.stop === 'function') {
            const r = rec.stop()
            if (r && typeof r.then === 'function') r.catch(() => {})
          }
        } catch (_) {}
        if (typeof rec.destroy === 'function') {
          try { rec.destroy() } catch (_) {}
        }
        recognitionRef.current = null
      }
      const arec = audioRecorderRef.current
      if (arec) {
        try { arec.cancel() } catch (_) {}
        audioRecorderRef.current = null
      }
      if (voskListenerRef.current) {
        try { voskListenerRef.current() } catch (_) {}
        voskListenerRef.current = null
      }
      cancelVoskListening().catch(() => {})
      if (hangCheckRef.current) {
        clearTimeout(hangCheckRef.current)
        hangCheckRef.current = null
      }
      if (durationTimerRef.current) {
        clearInterval(durationTimerRef.current)
        durationTimerRef.current = null
      }
      if (longPressTimerRef.current) {
        clearTimeout(longPressTimerRef.current)
        longPressTimerRef.current = null
      }
      if (pauseTimerRef.current) {
        clearTimeout(pauseTimerRef.current)
        pauseTimerRef.current = null
      }
    }
  }, [])

  useEffect(() => {
    if (!toolbarOpen) return
    const handleClickOutside = (e) => {
      setToolbarOpen(false)
    }
    document.addEventListener('click', handleClickOutside)
    return () => document.removeEventListener('click', handleClickOutside)
  }, [toolbarOpen])

  const handleImageSelect = useCallback(
    (e, inputRef) => {
      const files = Array.from(e.target.files || [])
      if (!files.length) return
      setToolbarOpen(false)
      setTimeout(() => { if (inputRef.current) inputRef.current.value = '' }, 200)
      // 临时跳过图片编辑裁剪，直接识别
      for (const file of files) {
        onImageOCR(file)
      }
    },
    [onImageOCR],
  )

  // ---- PC 引擎文档解析 ----
  const handlePcDocSelect = useCallback(
    (e) => {
      const file = e.target.files?.[0]
      if (!file) return
      setToolbarOpen(false)
      const { pcEngineServer, pcEnginePort, pcEngineToken, pcEngineParseEngine } = state
      if (!pcEngineServer) {
        showMsg('请先在「设置 → PC 引擎代理」中配置 PC IP 地址', 'warn', [{ label: '去设置', onClick: () => navigate('/settings/pc-engine') }])
        setTimeout(() => { if (documentInputRef.current) documentInputRef.current.value = '' }, 200)
        return
      }
      setPcDocParsing(true)
      setPcDocProgress(0)
      const baseUrl = `http://${pcEngineServer}:${pcEnginePort || '19000'}`
      const abortCtrl = new AbortController()
      parseDocument(baseUrl, pcEngineToken, file, pcEngineParseEngine || 'mineru', (progress) => {
        setPcDocProgress(progress)
      }, abortCtrl.signal)
        .then((markdown) => {
          if (markdown) {
            onChange(value + (value ? '\n\n' : '') + markdown.trim())
            showMsg('文档解析完成，已写入输入框', 'success')
          }
        })
        .catch((err) => {
          if (err.name === 'AbortError') return
          showMsg(`文档解析失败: ${err.message || '未知错误'}`, 'error')
        })
        .finally(() => {
          setPcDocParsing(false)
          setPcDocProgress(0)
          setTimeout(() => { if (documentInputRef.current) documentInputRef.current.value = '' }, 200)
        })
    },
    [state, value, onChange, showMsg, navigate]
  )

  const handleDocumentSelect = () => documentInputRef.current?.click()

  // ---- PC 引擎语音（OpenLess WebSocket） ----
  const startPcVoiceRecognition = useCallback(async () => {
    const { pcEngineServer, pcEnginePort, pcEngineToken, pcEngineAsr } = state
    if (!pcEngineServer) {
      showMsg('请先在「设置 → PC 引擎代理」中配置 PC IP 地址', 'warn', [{ label: '去设置', onClick: () => navigate('/settings/pc-engine') }])
      return
    }
    setStarting(true)
    try {
      const baseUrl = `http://${pcEngineServer}:${pcEnginePort || '19000'}`
      const asrEngine = pcEngineAsr || 'voice'
      const session = createPcVoiceSession(baseUrl, pcEngineToken, asrEngine, {
        onReady: () => {
          setStarting(false)
          setRecording(true)
          session.start()
          // 启动麦克风并发送音频
          startPcMicStream(session)
        },
        onStatus: (kind) => {
          if (kind === 'recording') {
            setRecording(true)
            setTranscribing(false)
          } else if (kind === 'transcribing' || kind === 'polishing') {
            setTranscribing(true)
          } else if (kind === 'done') {
            setRecording(false)
            setTranscribing(false)
          } else if (kind === 'error') {
            setRecording(false)
            setStarting(false)
            setTranscribing(false)
          }
        },
        onResult: (text) => {
          if (text) {
            const cleaned = cleanUpSpeechText(text)
            onChange(value + (value ? '\n' : '') + cleaned)
          }
          setRecording(false)
          setTranscribing(false)
          if (pcVoiceSessionRef.current) {
            pcVoiceSessionRef.current.close()
            pcVoiceSessionRef.current = null
          }
        },
        onError: (message) => {
          showMsg(`PC 语音识别错误: ${message}，正在降级到手机端...`, 'warn')
          setRecording(false)
          setStarting(false)
          setTranscribing(false)
          // 自动降级到手机端 ASR
          if (pcVoiceSessionRef.current) {
            pcVoiceSessionRef.current.close()
            pcVoiceSessionRef.current = null
          }
          // 延迟后自动启动手机端语音识别
          setTimeout(() => {
            setPcEngineOverride(false)
            setStarting(true)
            startRecognition().catch(() => {
              setStarting(false)
              showMsg('降级失败，请手动点击麦克风重试', 'error')
            })
          }, 1500)
        },
        onBusy: (reason) => {
          showMsg(`PC 语音服务忙碌: ${reason}`, 'warn')
          setStarting(false)
        },
      })
      pcVoiceSessionRef.current = session
    } catch (err) {
      showMsg(`PC 语音连接失败: ${err.message}`, 'error')
      setStarting(false)
    }
  }, [state, value, onChange, showMsg, navigate])

  const startPcMicStream = useCallback(async (session) => {
    try {
      const audioCtx = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: 16000 })
      const stream = await navigator.mediaDevices.getUserMedia({
        audio: { channelCount: 1, sampleRate: 16000, echoCancellation: true }
      })
      const source = audioCtx.createMediaStreamSource(stream)
      const processor = audioCtx.createScriptProcessor(4096, 1, 1)
      source.connect(processor)
      processor.connect(audioCtx.destination)
      processor.onaudioprocess = (e) => {
        if (session.state !== 'recording') return
        const float32 = e.inputBuffer.getChannelData(0)
        const buf = new ArrayBuffer(float32.length * 2)
        const view = new DataView(buf)
        for (let i = 0; i < float32.length; i++) {
          const s = Math.max(-1, Math.min(1, float32[i]))
          view.setInt16(i * 2, s < 0 ? s * 0x8000 : s * 0x7fff, true)
        }
        session.sendAudio(buf)
      }
      // 保存引用以便清理
      pcVoiceAbortRef.current = { audioCtx, stream, source, processor }
    } catch (err) {
      showMsg(`麦克风启动失败: ${err.message}`, 'error')
      session.cancel()
      setRecording(false)
      setStarting(false)
    }
  }, [showMsg])

  const stopPcVoiceRecognition = useCallback(() => {
    const session = pcVoiceSessionRef.current
    if (session) {
      session.stop().catch(() => {})
    }
    // 清理麦克风
    const refs = pcVoiceAbortRef.current
    if (refs) {
      try {
        refs.processor?.disconnect()
        refs.source?.disconnect()
        refs.stream?.getTracks().forEach(t => t.stop())
        refs.audioCtx?.close()
      } catch (_) {}
      pcVoiceAbortRef.current = null
    }
  }, [])

  const handleCamera = () => cameraInputRef.current?.click()
  const handleGallery = () => galleryInputRef.current?.click()

  const handleSubmit = () => {
    const t = value.trim()
    if (!t || ocrLoading || disabled || cleaning || starting) return
    onSubmit(t)
  }

  const cancelRecording = useCallback(() => {
    const rec = recognitionRef.current
    if (rec) {
      try {
        if (typeof rec.stop === 'function') {
          const r = rec.stop()
          if (r && typeof r.then === 'function') r.catch(() => {})
        }
      } catch (_) {}
      if (typeof rec.destroy === 'function') {
        try { rec.destroy() } catch (_) {}
      }
      recognitionRef.current = null
    }
    const arec = audioRecorderRef.current
    if (arec) {
      try { arec.cancel() } catch (_) {}
      audioRecorderRef.current = null
    }
    setRecording(false)
    setStarting(false)
    showMsg('已取消录音', 'info')
  }, [showMsg])

  const handleMicClick = useCallback(async () => {
    if (disabled || cleaning) return
    if (recording || starting) {
      stopRecognition()
      return
    }
    setVoiceMode(true)
  }, [disabled, cleaning, recording, starting, stopRecognition])

  const handleVoiceRecordClick = useCallback(async () => {
    if (disabled || cleaning || starting) return
    if (recording) {
      if (effectiveMode === 'pc-engine-voice') {
        stopPcVoiceRecognition()
      } else {
        stopRecognition()
      }
    } else {
      transcriptRef.current = ''
      partialTranscriptRef.current = ''
      if (effectiveMode === 'pc-engine-voice') {
        await startPcVoiceRecognition()
      } else {
        setStarting(true)
        await startRecognition()
      }
      longPressTimerRef.current = setTimeout(() => {
        if (recording) {
          if (effectiveMode === 'pc-engine-voice') {
            stopPcVoiceRecognition()
          } else {
            stopRecognition()
          }
          showMsg('录音已自动停止（超过 60 秒）', 'info')
        }
      }, MAX_RECORDING_DURATION)
    }
  }, [disabled, cleaning, recording, starting, effectiveMode, stopRecognition, startRecognition, startPcVoiceRecognition, stopPcVoiceRecognition, showMsg])

  const handleVoiceRecordPressStart = useCallback(async () => {
    if (disabled || cleaning || starting || recording) return
    transcriptRef.current = ''
    partialTranscriptRef.current = ''
    if (effectiveMode === 'pc-engine-voice') {
      await startPcVoiceRecognition()
    } else {
      setStarting(true)
      await startRecognition()
    }
    longPressTimerRef.current = setTimeout(() => {
      if (recording) {
        if (effectiveMode === 'pc-engine-voice') {
          stopPcVoiceRecognition()
        } else {
          stopRecognition()
        }
        showMsg('录音已自动停止（超过 60 秒）', 'info')
      }
    }, MAX_RECORDING_DURATION)
  }, [disabled, cleaning, starting, recording, effectiveMode, startRecognition, stopRecognition, startPcVoiceRecognition, stopPcVoiceRecognition, showMsg])

  const handleVoiceRecordPressEnd = useCallback(() => {
    if (longPressTimerRef.current) {
      clearTimeout(longPressTimerRef.current)
      longPressTimerRef.current = null
    }
    if (recording) {
      if (effectiveMode === 'pc-engine-voice') {
        stopPcVoiceRecognition()
      } else {
        stopRecognition()
      }
    }
  }, [recording, stopRecognition, effectiveMode, stopPcVoiceRecognition])

  const exitVoiceMode = useCallback(() => {
    if (recording || starting) {
      if (effectiveMode === 'pc-engine-voice') {
        stopPcVoiceRecognition()
      } else {
        stopRecognition()
      }
    }
    setVoiceMode(false)
  }, [recording, starting, stopRecognition, effectiveMode, stopPcVoiceRecognition])

  const busy = recording || starting || cleaning || ocrLoading

  return (
    <React.Fragment>      {/* ============ 辅行工具栏 ============ */}
      <div style={{
        maxHeight: toolbarOpen ? '100px' : '0',
        overflow: 'hidden',
        marginBottom: toolbarOpen ? '6px' : '0',
        opacity: toolbarOpen ? 1 : 0,
        transition: 'max-height 0.25s ease, margin-bottom 0.25s ease, opacity 0.2s ease',
        pointerEvents: toolbarOpen ? 'auto' : 'none',
      }}>
        <div style={{
          display: 'flex',
          gap: '8px',
          width: '100%',
          marginBottom: '8px',
        }}>
          <button onClick={handleCamera} disabled={disabled || cleaning || ocrLoading} aria-label="拍照识别" style={{
            flex: 1, minHeight: '38px', padding: '6px 10px', borderRadius: '10px',
            backgroundColor: 'var(--color-surface-solid)', border: '1.5px solid var(--color-border)',
            color: 'var(--color-text)', fontSize: '12px', fontWeight: 500,
            cursor: (disabled || cleaning || ocrLoading) ? 'not-allowed' : 'pointer',
            display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '5px',
            transition: 'all 0.15s ease', opacity: (disabled || cleaning || ocrLoading) ? 0.45 : 1,
          }}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            拍照
          </button>
          <button onClick={handleGallery} disabled={disabled || cleaning || ocrLoading} aria-label="从相册选取" style={{
            flex: 1, minHeight: '38px', padding: '6px 10px', borderRadius: '10px',
            backgroundColor: 'var(--color-surface-solid)', border: '1.5px solid var(--color-border)',
            color: 'var(--color-text)', fontSize: '12px', fontWeight: 500,
            cursor: (disabled || cleaning || ocrLoading) ? 'not-allowed' : 'pointer',
            display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '5px',
            transition: 'all 0.15s ease', opacity: (disabled || cleaning || ocrLoading) ? 0.45 : 1,
          }}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            相册
          </button>
          {state.pcEngineServer && (
            <button onClick={handleDocumentSelect} disabled={disabled || cleaning || ocrLoading || pcDocParsing} aria-label="PC文档解析" style={{
              flex: 1, minHeight: '38px', padding: '6px 10px', borderRadius: '10px',
              backgroundColor: 'var(--color-surface-solid)', border: '1.5px solid var(--color-border)',
              color: 'var(--color-text)', fontSize: '12px', fontWeight: 500,
              cursor: (disabled || cleaning || ocrLoading || pcDocParsing) ? 'not-allowed' : 'pointer',
              display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '5px',
              transition: 'all 0.15s ease', opacity: (disabled || cleaning || ocrLoading || pcDocParsing) ? 0.45 : 1,
            }}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              {pcDocParsing ? `解析中 ${pcDocProgress}%` : '文档'}
            </button>
          )}
        </div>
        <div style={{ display: 'flex', gap: '6px' }}>
          {SUMMARY_LEVELS.map((level) => {
            const isActive = summaryLevel === level.value
            return (
              <button key={level.value} onClick={() => onSummaryLevelChange && onSummaryLevelChange(level.value)} style={{
                flex: 1, minHeight: '32px', padding: '3px 4px', borderRadius: '8px',
                border: isActive ? '1.5px solid var(--color-primary)' : '1.5px solid var(--color-border)',
                backgroundColor: isActive ? 'var(--color-primary-light)' : 'var(--color-surface-solid)',
                color: isActive ? 'var(--color-primary-dark)' : 'var(--color-text-secondary)',
                fontSize: '11px', fontWeight: isActive ? 600 : 500, cursor: 'pointer',
                display: 'flex', alignItems: 'center', justifyContent: 'center',
                transition: 'all 0.15s ease',
              }}>{level.label}</button>
            )
          })}
        </div>
      </div>

      {/* ============ 主行 ============ */}
      {voiceMode ? (
        <div style={{ display: 'flex', alignItems: 'center', gap: '8px', width: '100%' }}>
          {/* [⌨] 切回文字输入 */}
          <button onClick={exitVoiceMode} disabled={recording || starting} aria-label="切换到键盘输入" style={{
            width: '44px', height: '44px', flexShrink: 0, borderRadius: '12px',
            backgroundColor: 'var(--color-surface-solid)', color: 'var(--color-text-secondary)', border: '1.5px solid var(--color-border)',
            cursor: (recording || starting) ? 'not-allowed' : 'pointer',
            display: 'flex', alignItems: 'center', justifyContent: 'center',
            transition: 'all 0.15s ease', opacity: (recording || starting) ? 0.45 : 1,
          }}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h.001M10 8h.001M14 8h.001M18 8h.001M8 12h.001M12 12h.001M16 12h.001M7 16h10"/></svg>
          </button>

          {/* 语音输入区域 */}
          <div
            onClick={handleVoiceRecordClick}
            onPointerDown={(e) => { 
              e.currentTarget.dataset.touchStart = Date.now()
              if (!recording && !starting && !disabled && !cleaning) {
                handleVoiceRecordPressStart()
              }
            }}
            onPointerUp={(e) => {
              const start = parseInt(e.currentTarget.dataset.touchStart || '0')
              if (Date.now() - start > 500 && recording) {
                handleVoiceRecordPressEnd()
              }
            }}
            onPointerLeave={() => { 
              if (recording) handleVoiceRecordPressEnd() 
            }}
            style={{
              flex: 1, minWidth: 0, height: '48px', borderRadius: '24px',
              backgroundColor: recording ? 'var(--color-danger-light)' : (starting ? 'var(--color-primary-light)' : 'var(--color-bg)'),
              border: '1.5px solid',
              borderColor: recording ? 'var(--color-danger)' : (starting ? 'var(--color-primary)' : 'var(--color-border)'),
              cursor: (disabled || cleaning || starting) ? 'wait' : 'pointer',
              display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '10px',
              transition: 'all 0.2s ease',
              userSelect: 'none', WebkitUserSelect: 'none', WebkitTouchCallout: 'none',
              touchAction: 'none',
            }}
          >
            {recording ? (
              <>
                <span style={{
                  width: 10, height: 10, borderRadius: '50%', backgroundColor: 'var(--color-danger)',
                  animation: 'blink 0.8s ease-in-out infinite', flexShrink: 0,
                }} />
                <span style={{ fontSize: '15px', fontWeight: 600, color: 'var(--color-danger)', fontVariantNumeric: 'tabular-nums' }}>
                  {fmt(recordingDuration)}
                </span>
                <span style={{ fontSize: '13px', color: 'var(--color-danger)', opacity: 0.8 }}>
                  点击停止
                </span>
              </>
            ) : starting ? (
              <>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" style={{ animation: 'spin 1s linear infinite', color: 'var(--color-primary)' }}><path d="M21 12a9 9 0 11-6.219-8.56"/></svg>
                <span style={{ fontSize: '14px', fontWeight: 500, color: 'var(--color-primary)' }}>准备中…</span>
              </>
            ) : (
              <>
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{ color: 'var(--color-primary)' }}>
                  <rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0014 0"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="8" y1="22" x2="16" y2="22"/>
                </svg>
                <span style={{ fontSize: '14px', fontWeight: 500, color: 'var(--color-text-secondary)' }}>
                  点击录音
                </span>
              </>
            )}
          </div>

          {/* [↑] 发送 */}
          <button onClick={handleSubmit} disabled={!value.trim() || ocrLoading || disabled || cleaning || starting || recording} aria-label="生成卡片" style={{
            width: '44px', height: '44px', flexShrink: 0, borderRadius: '12px',
            backgroundColor: 'var(--color-success)', color: '#ffffff', border: 'none',
            cursor: (!value.trim() || ocrLoading || disabled || cleaning || starting || recording) ? 'not-allowed' : 'pointer',
            display: 'flex', alignItems: 'center', justifyContent: 'center',
            transition: 'all 0.15s ease', opacity: ((!value.trim() || ocrLoading || disabled || cleaning || starting || recording)) ? 0.45 : 1,
          }}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
          </button>
        </div>
      ) : (
      <div style={{ display: 'flex', alignItems: 'center', gap: '6px', width: '100%' }}>
        {/* [▾] 展开箭头 */}
        <button onClick={(e) => { e.stopPropagation(); setToolbarOpen(!toolbarOpen) }} disabled={disabled || cleaning || starting} aria-label={toolbarOpen ? '收起工具栏' : '展开工具栏'} style={{
          width: '28px', height: '44px', flexShrink: 0, borderRadius: '8px',
          backgroundColor: 'transparent', color: 'var(--color-text-muted)', border: 'none',
          cursor: (disabled || cleaning || starting) ? 'not-allowed' : 'pointer',
          display: 'flex', alignItems: 'center', justifyContent: 'center',
          transition: 'all 0.15s ease', opacity: (disabled || cleaning) ? 0.45 : 1,
        }}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" style={{ transform: toolbarOpen ? 'rotate(180deg)' : 'none', transition: 'transform 0.2s ease' }}><path d="M6 9l6 6 6-6"/></svg>
        </button>

        {/* 输入框 */}
        <div style={{ flex: 1, minWidth: 0, position: 'relative' }}>
          <textarea 
            ref={textareaRef}
            value={value} 
            onChange={(e) => { onChange(e.target.value); setTimeout(autoResize, 0) }} 
            placeholder="输入背诵内容" 
            disabled={disabled || cleaning} 
            style={{
              width: '100%', boxSizing: 'border-box', padding: '11px 30px 11px 16px', borderRadius: '16px',
              backgroundColor: 'var(--color-bg)', border: '1.5px solid var(--color-border)',
              color: 'var(--color-text)', fontSize: '15px', lineHeight: 1.5, resize: 'none', outline: 'none',
              overflowY: 'hidden',
              fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif', transition: 'all 0.15s ease',
            }} 
            onFocus={(e) => { e.currentTarget.style.backgroundColor = 'var(--color-surface-solid, #FFFFFF)'; e.currentTarget.style.borderColor = 'var(--color-primary)'; e.currentTarget.style.boxShadow = '0 0 0 3px var(--color-primary-alpha)' }} 
            onBlur={(e) => { e.currentTarget.style.backgroundColor = 'var(--color-bg)'; e.currentTarget.style.borderColor = 'var(--color-border)'; e.currentTarget.style.boxShadow = 'none' }} 
          />
          <button
            onClick={(e) => {
              e.stopPropagation()
              setDraftText(value)
              setExpandOpen(true)
              setTimeout(() => panelTextareaRef.current?.focus(), 100)
            }}
            disabled={disabled || cleaning}
            aria-label="展开文本编辑"
            style={{
              position: 'absolute',
              right: '4px',
              top: '11px',
              width: '28px',
              height: '28px',
              borderRadius: '6px',
              backgroundColor: 'transparent',
              color: 'var(--color-text-muted)',
              border: 'none',
              cursor: (disabled || cleaning) ? 'not-allowed' : 'pointer',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'center',
              opacity: (disabled || cleaning) ? 0.35 : 0.7,
              transition: 'opacity 0.15s ease',
            }}
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <polyline points="15 3 21 3 21 9" />
              <polyline points="9 21 3 21 3 15" />
              <line x1="21" y1="3" x2="14" y2="10" />
              <line x1="3" y1="21" x2="10" y2="14" />
            </svg>
          </button>
        </div>

        {/* 麦克风按钮 */}
        <div style={{ position: 'relative', flexShrink: 0 }}>
          <button 
            onClick={handleMicClick}
            disabled={disabled || ocrLoading || cleaning || starting} 
            aria-label={recording ? '停止录音' : '语音输入'} 
            style={{
              width: '44px', 
              height: '44px', 
              flexShrink: 0, 
              borderRadius: '50%',
              backgroundColor: recording ? 'var(--color-danger)' : (starting ? 'var(--color-primary-light)' : 'var(--color-surface-solid)'), 
              color: recording ? '#ffffff' : 'var(--color-primary)',
              border: 'none', 
              cursor: (disabled || ocrLoading || cleaning || starting) ? 'not-allowed' : 'pointer',
              display: 'flex', 
              alignItems: 'center', 
              justifyContent: 'center',
              transition: 'all 0.2s ease', 
              opacity: (disabled || ocrLoading || cleaning) ? 0.5 : 1,
              boxShadow: recording ? '0 0 0 4px rgba(239,68,68,0.25), 0 2px 8px rgba(239,68,68,0.4)' : (starting ? '0 0 0 4px rgba(59,130,246,0.25), 0 2px 8px rgba(59,130,246,0.3)' : '0 2px 8px rgba(0,0,0,0.12)'),
              animation: recording ? 'mic-pulse 1.2s ease-in-out infinite' : (starting ? 'mic-pulse 0.8s ease-in-out infinite' : 'none'),
            }}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              {recording ? (<rect x="7" y="7" width="10" height="10" rx="2" fill="currentColor" stroke="currentColor"/>) : (<><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0014 0"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="8" y1="22" x2="16" y2="22"/></>)}
            </svg>
          </button>
          {starting && (
            <div style={{
              position: 'absolute', bottom: '-22px', left: '50%', transform: 'translateX(-50%)',
              fontSize: '10px', color: 'var(--color-primary)', whiteSpace: 'nowrap',
              padding: '2px 6px', backgroundColor: 'var(--color-primary-light)',
              borderRadius: '4px', pointerEvents: 'none',
            }}>
              准备中
            </div>
          )}
          
          {recording && (
            <div style={{
              position: 'absolute',
              right: 0,
              top: '50%',
              transform: 'translateY(-50%)',
              translate: 'calc(100% + 4px) 0',
              fontSize: 11,
              fontWeight: 600,
              color: recordingDuration >= 60 ? 'var(--color-warning)' : 'var(--color-danger)',
              fontVariantNumeric: 'tabular-nums',
              whiteSpace: 'nowrap',
              animation: recordingDuration >= 60 ? 'blink 0.6s ease-in-out infinite' : 'none',
              pointerEvents: 'none',
            }}>
              {fmt(recordingDuration)}
            </div>
          )}
        </div>

        {/* [↑] 发送 */}
        <button onClick={handleSubmit} disabled={!value.trim() || ocrLoading || disabled || cleaning || starting} aria-label="生成卡片" style={{
          width: '44px', height: '44px', flexShrink: 0, borderRadius: '12px',
          backgroundColor: 'var(--color-success)', color: '#ffffff', border: 'none',
          cursor: (!value.trim() || ocrLoading || disabled || cleaning || starting) ? 'not-allowed' : 'pointer',
          display: 'flex', alignItems: 'center', justifyContent: 'center',
          transition: 'all 0.15s ease', opacity: ((!value.trim() || ocrLoading || disabled || cleaning || starting)) ? 0.45 : 1,
        }}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>
        </button>
      </div>
      )}

      {/* 忙碌状态条 */}
      {busy && (
        <div style={{ marginTop: '6px', padding: '8px 12px', borderRadius: '10px', backgroundColor: starting ? 'var(--color-warning-light)' : cleaning ? 'var(--color-primary-light)' : (recording ? 'var(--color-danger-light)' : 'var(--color-primary-light)'), color: starting ? 'var(--color-warning-dark)' : cleaning ? 'var(--color-primary-dark)' : (recording ? 'var(--color-danger)' : 'var(--color-primary-dark)'), fontSize: '12px', fontWeight: 500, display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '8px' }}>
          {starting && !recording && (<><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" style={{ animation: 'spin 1s linear infinite' }}><path d="M21 12a9 9 0 11-6.219-8.56"/></svg><span>正在启动语音识别…</span></>)}
          {recording && (<><span style={{ width: 8, height: 8, borderRadius: '50%', backgroundColor: 'var(--color-danger)', animation: 'blink 0.8s ease-in-out infinite', flexShrink: 0 }} /><span>正在录音 {fmt(recordingDuration)}</span></>)}
          {cleaning && !recording && !starting && (<><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" style={{ animation: 'spin 1s linear infinite' }}><path d="M21 12a9 9 0 11-6.219-8.56"/></svg><span>{transcribing ? '正在识别语音…' : 'AI 正在整理...'}</span></>)}
          {ocrLoading && !recording && !cleaning && !starting && (<><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="12" cy="12" r="10" strokeOpacity="0.25"/><path d="M4 12a8 8 0 018-8" fill="none"/></svg><span>正在识别图片...</span></>)}
        </div>
      )}

      {/* 语音预览（录音时实时显示） */}
      {recording && voicePreview && (
        <div style={{
          marginTop: '6px',
          padding: '10px 12px',
          borderRadius: '10px',
          backgroundColor: 'var(--color-danger-light)',
          color: 'var(--color-text)',
          fontSize: '14px',
          lineHeight: 1.5,
          maxHeight: '100px',
          overflowY: 'auto',
          borderLeft: '3px solid var(--color-danger)',
          whiteSpace: 'pre-wrap',
          wordBreak: 'break-word',
        }}>
          {voicePreview}
          <span style={{ opacity: 0.5, animation: 'blink 1s ease-in-out infinite' }}>|</span>
        </div>
      )}

      {/* ============ 多行文本展开底部面板 ============ */}
      {expandOpen && (
        <div
          className="expand-panel-overlay"
          onClick={(e) => {
            e.stopPropagation()
            setExpandOpen(false)
          }}
          style={{
            position: 'fixed',
            top: 0, left: 0, right: 0, bottom: 0,
            zIndex: 100,
            backgroundColor: 'rgba(0,0,0,0.4)',
            display: 'flex',
            alignItems: 'flex-end',
            justifyContent: 'center',
            animation: 'expandPanelFadeIn 0.2s ease',
          }}
        >
          <div
            className="expand-panel"
            onClick={(e) => e.stopPropagation()}
            style={{
              width: '100%',
              maxWidth: '540px',
              maxHeight: '85vh',
              backgroundColor: 'var(--color-surface-solid)',
              borderRadius: '20px 20px 0 0',
              display: 'flex',
              flexDirection: 'column',
              overflowY: 'auto',
              animation: 'expandPanelSlideUp 0.25s cubic-bezier(0.32, 0.72, 0, 1)',
              boxShadow: '0 -4px 24px rgba(0,0,0,0.15)',
              paddingBottom: 'env(safe-area-inset-bottom)',
            }}
          >
            {/* 标题栏 */}
            <div style={{
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
              padding: '14px 16px 10px',
              borderBottom: '1px solid var(--color-border)',
            }}>
              <span style={{ fontSize: '15px', fontWeight: 600, color: 'var(--color-text)' }}>编辑文本</span>
              <button
                onClick={() => setExpandOpen(false)}
                aria-label="关闭"
                style={{
                  width: '32px', height: '32px', borderRadius: '50%',
                  backgroundColor: 'transparent', color: 'var(--color-text-muted)',
                  border: 'none', cursor: 'pointer',
                  display: 'flex', alignItems: 'center', justifyContent: 'center',
                  fontSize: '18px',
                }}
              >✕</button>
            </div>

            {/* 文本区域 */}
            <textarea
              ref={panelTextareaRef}
              value={draftText}
              onChange={(e) => setDraftText(e.target.value)}
              placeholder="输入背诵内容"
              className="expand-panel-textarea"
              style={{
                flex: 1,
                minHeight: '200px',
                padding: '14px 16px',
                border: 'none',
                outline: 'none',
                fontSize: '15px',
                lineHeight: 1.6,
                color: 'var(--color-text)',
                backgroundColor: 'var(--color-bg)',
                fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
                resize: 'none',
                margin: '8px 12px',
                borderRadius: '12px',
              }}
            />

            {/* 底部按钮 */}
            <div style={{
              display: 'flex',
              gap: '10px',
              padding: '10px 16px 14px',
              borderTop: '1px solid var(--color-border)',
            }}>
              <button
                onClick={() => setExpandOpen(false)}
                style={{
                  flex: 1, minHeight: '44px', padding: '10px 16px',
                  borderRadius: '12px', border: '1.5px solid var(--color-border)',
                  backgroundColor: 'var(--color-surface-solid)', color: 'var(--color-text)',
                  fontSize: '14px', fontWeight: 500, cursor: 'pointer',
                }}
              >取消</button>
              <button
                onClick={() => {
                  onChange(draftText)
                  setExpandOpen(false)
                }}
                style={{
                  flex: 1, minHeight: '44px', padding: '10px 16px',
                  borderRadius: '12px', border: 'none',
                  backgroundColor: 'var(--color-primary)', color: '#ffffff',
                  fontSize: '14px', fontWeight: 600, cursor: 'pointer',
                }}
              >确认</button>
            </div>
          </div>
        </div>
      )}

      {/* 隐藏的文件输入 */}
      <input ref={cameraInputRef} type="file" accept="image/*" capture="environment" onChange={(e) => handleImageSelect(e, cameraInputRef)} style={{ display: 'none' }}/>
      <input ref={galleryInputRef} type="file" accept="image/*" multiple onChange={(e) => handleImageSelect(e, galleryInputRef)} style={{ display: 'none' }}/>
      <input ref={documentInputRef} type="file" accept=".pdf,.png,.jpg,.jpeg,.docx,.pptx,.xlsx,.html,.wav,.mp3,.txt" onChange={handlePcDocSelect} style={{ display: 'none' }}/>

      {/* 语音确认弹窗 */}
      {showVoiceConfirm && (
        <div
          onClick={(e) => {
            e.stopPropagation()
            handleVoiceSaveAndClose()
          }}
          style={{
            position: 'fixed',
            top: 0, left: 0, right: 0, bottom: 0,
            zIndex: 200,
            backgroundColor: 'rgba(0,0,0,0.5)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            padding: '20px',
            animation: 'expandPanelFadeIn 0.2s ease',
          }}
        >
          <div
            onClick={(e) => e.stopPropagation()}
            style={{
              width: '100%',
              maxWidth: '480px',
              backgroundColor: 'var(--color-surface-solid)',
              borderRadius: '16px',
              boxShadow: '0 8px 32px rgba(0,0,0,0.2)',
              animation: 'expandPanelSlideUp 0.25s cubic-bezier(0.32, 0.72, 0, 1)',
            }}
          >
            <div style={{
              padding: '16px 16px 12px',
              borderBottom: '1px solid var(--color-border)',
              display: 'flex',
              alignItems: 'center',
              justifyContent: 'space-between',
            }}>
              <span style={{ fontSize: '16px', fontWeight: 600, color: 'var(--color-text)' }}>语音识别结果</span>
              <button
                onClick={handleVoiceSaveAndClose}
                aria-label="保存并关闭"
                title="保存到输入框"
                style={{
                  width: '32px', height: '32px', borderRadius: '50%',
                  backgroundColor: 'transparent', color: 'var(--color-text-muted)',
                  border: 'none', cursor: 'pointer',
                  display: 'flex', alignItems: 'center', justifyContent: 'center',
                  fontSize: '18px',
                }}
              >✕</button>
            </div>
            <textarea
              value={voicePreview}
              onChange={(e) => setVoicePreview(e.target.value)}
              style={{
                width: '100%',
                minHeight: '150px',
                maxHeight: '300px',
                padding: '14px 16px',
                border: 'none',
                outline: 'none',
                fontSize: '15px',
                lineHeight: 1.6,
                color: 'var(--color-text)',
                backgroundColor: 'var(--color-bg)',
                resize: 'none',
                fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
              }}
              placeholder="语音识别内容"
            />
            <div style={{
              padding: '12px 16px',
              display: 'flex',
              gap: '12px',
              borderTop: '1px solid var(--color-border)',
            }}>
              <button
                onClick={handleVoiceCancel}
                style={{
                  flex: 1,
                  padding: '10px 16px',
                  borderRadius: '10px',
                  border: '1px solid var(--color-border)',
                  backgroundColor: 'transparent',
                  color: 'var(--color-text)',
                  fontSize: '14px',
                  fontWeight: 500,
                  cursor: 'pointer',
                  transition: 'all 0.15s ease',
                }}
              >取消</button>
              <button
                onClick={handleVoiceConfirm}
                disabled={!voicePreview.trim()}
                style={{
                  flex: 1,
                  padding: '10px 16px',
                  borderRadius: '10px',
                  border: 'none',
                  backgroundColor: 'var(--color-primary)',
                  color: '#ffffff',
                  fontSize: '14px',
                  fontWeight: 600,
                  cursor: !voicePreview.trim() ? 'not-allowed' : 'pointer',
                  opacity: !voicePreview.trim() ? 0.5 : 1,
                  transition: 'all 0.15s ease',
                }}
              >确认输入</button>
            </div>
          </div>
        </div>
    </React.Fragment>
  )
}